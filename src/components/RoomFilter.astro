---
import { getCollection } from 'astro:content';

const { query } = Astro.props;

const allBlogs = await getCollection('blog', ({id}) => {
	return id.includes(query);
}); 

const allFaves = await getCollection('favourites', ({id}) => {
	return id.includes(query);
}); 

const allLogs = await getCollection('logs', ({id}) => {
	return id.includes(query);
}); 

const allMisc = await getCollection('misc', ({id}) => {
	return id.includes(query);
});

const allNames = await getCollection('nicknames', ({id}) => {
	return id.includes(query);
});

const combinedColl = allBlogs.concat(allFaves, allLogs, allMisc, allNames);

---

{combinedColl.length > 0 ? <ul class="pokeball-icons">
	{allBlogs.map((post) => (
		<li>
			<a href={`/blog/${post.id}/`}>{post.data.title}</a>
		</li>
		))
	}
	{allFaves.map((post) => (
		<li>
			<a href={`/favourites/${post.id}/`}>{post.data.title}</a>
		</li>
		))
	}
	{allLogs.map((post) => (
		<li>
			<a href={`/logs/${post.id}/`}>{post.data.title}</a>
		</li>
		))
	}
	{allMisc.map((post) => (
		<li>
			<a href={`/misc/${post.id}/`}>{post.data.title}</a>
		</li>
		))
	}
	{allNames.map((post) => (
		<li>
			<a href={`/nicknames/${post.id}/`}>{post.data.title}</a>
		</li>
		))
	}
</ul> : "Coming soon!"}